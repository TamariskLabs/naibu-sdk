# Naibu API credentials (copy to .env and fill in; .env is git-ignored)

# --- API key / bearer token auth ---
NAIBU_API_KEY=

# --- OAuth2 client-credentials auth (alternative to API key) ---
NAIBU_CLIENT_ID=
NAIBU_CLIENT_SECRET=
NAIBU_TOKEN_URL=
NAIBU_SCOPE=

# --- Optional overrides ---
# NAIBU_BASE_URL=https://api.naibu.com
